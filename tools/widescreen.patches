# ---- Sprite blitter 0x880104e8 (fighters, stage objects, 3D-scene sprites, HUD sprites) ----
# Full-screen-clipped calls on frames with drawn margins become wide (ws_sprite_enter); a wide
# call starts at row y*1024 of the wide buffer's column-WS_M origin.
880104e8 after ws_sprite_enter(c);
88010610 code c->r[4] = ws_wide_sprite(c) ? 0x400 : 0x280;
88010654 after if (ws_wide_sprite(c)) c->r[2] = S32(ws_origin(uint32_t(c->r[2])));

# ---- Full-screen colour passes (fades, flashes, the darkening before a finisher) ----
# They sweep the 320x240 framebuffer linearly; on frames with drawn margins they sweep the whole
# wide buffer instead (start = wide row 0, length 240 rows of 1024 bytes).
88001594 code if (c->bus->back_has_margins()) { c->r[2] = S32(ws_row0(uint32_t(c->r[2]))); c->r[4] = S32(uint32_t(c->r[2]) + 240 * WS_PITCH); } else c->r[4] = S32(uint32_t(c->r[2]) + uint32_t(c->r[4]));
8800161c code if (c->bus->back_has_margins()) { c->r[2] = S32(ws_row0(uint32_t(c->r[2]))); c->r[4] = S32(uint32_t(c->r[2]) + 240 * WS_PITCH); } else c->r[4] = S32(uint32_t(c->r[2]) + uint32_t(c->r[4]));
8801871c code if (c->bus->back_has_margins()) { c->r[2] = S32(ws_row0(uint32_t(c->r[2]))); c->r[7] = 240 * WS_PITCH / 8; } else c->r[7] = 0x4b00;
88018684 code if (c->bus->back_has_margins()) { c->r[2] = S32(ws_row0(uint32_t(c->r[2]))); c->r[4] = 240 * WS_PITCH / 8; } else c->r[4] = 0x4b00;

