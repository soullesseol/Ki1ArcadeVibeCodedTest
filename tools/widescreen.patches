# Widescreen patches for kirecomp (boot_main). Each line replaces one plain (non-branch)
# instruction when the bus is in widescreen mode; the original still runs otherwise:
#   <pc> word <hex>   alternative instruction word       # comment
#   <pc> code <C++>   alternative C++ statement (no comment on this line)
# Patched routines draw into view B (memmap.h: WS_BASE, 1024-byte rows, x = -WS_M..319+WS_M).

# ---- Background layers, 3D stages (0x8801854c: layer list at [0x8808de3c]) ----
# Panorama layer caller: source x - WS_M, fb = wide row 0.
88018604 code c->r[4] = S32(uint32_t(c->lo) - WS_M);
88018630 code c->r[2] = S32(ws_row0(RD<uint32_t>(c, c->r[2] + 1248)));
# Panorama blitter 0x880189b8 (a0 src x, a1 y, a2 width, a3 rows, v1 src, v0 fb): 432 columns,
# 1024-byte rows (dest advances 160 bytes more per row on every path).
88018a24 word 00052a40   # sll a1,a1,9         (y*640 -> y*1024)
88018a60 word 24c8fe54   # addiu t0,a2,-0x1ac  (wrap split when fewer than 428 px remain)
88018a80 word 24c6fe50   # addiu a2,a2,-0x1b0  (source row skip)
88018a88 word 240a001b   # addiu t2,zero,0x1b  (27 x 16 px per row)
88018ae4 code c->r[3] = S32(uint32_t(c->r[3]) + uint32_t(c->r[6])); c->r[2] = S32(uint32_t(c->r[2]) + 160);
88018b14 word 240a006c   # addiu t2,zero,0x6c  (108 x 4 px per row, split path)
88018ba8 code c->r[5] = S32(uint32_t(c->r[5]) + uint32_t(c->r[12])); c->r[2] = S32(uint32_t(c->r[2]) + 160);
88018bec code c->r[4] = S32(uint32_t(c->r[4]) + uint32_t(c->r[11])); c->r[2] = S32(uint32_t(c->r[2]) + 160);
# Black above the first layer (0x88018954): a1 whole wide rows.
88018980 word 00052180   # sll a0,a1,6         (128 dwords per row)
88018984 code c->r[2] = S32(ws_row0(RD<uint32_t>(c, c->r[2] + 1248)));
# Solid floor colour layer (0x880188d8): whole wide rows from y down.
8801890c code c->r[2] = S32(ws_row0(RD<uint32_t>(c, c->r[2] + 1248)));
88018914 word 00054240   # sll t0,a1,9
88018924 word 24080080   # addiu t0,zero,0x80

# ---- Polygon rasterizers (3D floor and stage objects, called from the BSP walk 0x88014990) ----
# Three triangle families with 6 span routines each, entered at a/b/c points that save every
# register and jump to a common outcode clip:
#   A 0x88019fa0/a044/a0e8 -> 0x8801a18c, B 0x8801ade0/ae84 -> 0x8801af28,
#   C 0x8801bbd0/bc74/bd18 -> 0x8801bdbc; and the edge line drawer 0x8801ca60.
# In widescreen they draw in x' = x + WS_M (so their sign-test left clip lands at x = -WS_M) into
# wide row 0 with 1024-byte rows; right limits 320 -> 432 (x' of the right margin edge).
8801a040 after ws_raster_enter(c, {4, 6, 8});
8801a0e4 after ws_raster_enter(c, {4, 6, 8});
8801a188 after ws_raster_enter(c, {4, 6, 8});
8801ae80 after ws_raster_enter(c, {4, 6, 8});
8801af24 after ws_raster_enter(c, {4, 6, 8});
8801bc70 after ws_raster_enter(c, {4, 6, 8});
8801bd14 after ws_raster_enter(c, {4, 6, 8});
8801bdb8 after ws_raster_enter(c, {4, 6, 8});
8801cadc after ws_raster_enter(c, {4, 6});
# Limits and strides inside them (generated: slti/addiu 0x140 0x13f 0x27f 0x27e 0x280, y<<7 of y*640).
8801a19c word 288101b0   # slti $at, $a0, 0x140 -> 0x1b0
8801a1dc word 28c101b0   # slti $at, $a2, 0x140 -> 0x1b0
8801a21c word 290101b0   # slti $at, $t0, 0x140 -> 0x1b0
8801a434 word 0005fa40   # sll $ra, $a1, 7 -> 9 (y*1024)
